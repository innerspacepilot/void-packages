pre_configure() {
	# find -type f | \
	# 	grep "configure\.ac\|Makefile\|cmake\|config\.site" | \
	# 	xargs sed -i  -e "s;-isystem;-I;g"

	# # Copy generated files to avoid requiring java.
	# mkdir -p build/build/swig

	# # THESE FILES MUST BE UPDATED WITH EVERY VERSION BUMP!
	# # (See kodi template)
	# cp -r $FILESDIR/swig.nojava-$version/* -t build/build/swig
	# cp $FILESDIR/CMakeCache.txt.nojava build/CMakeCache.txt

	# echo "set(FOUND_SWIG Yes)" > cmake/modules/FindSWIG.cmake
	(CC= LD= CXX= LDFLAGS= CFLAGS= CXXFLAGS=; cd tools/depends; autoconf -f; ./configure --with-toolchain=/usr/aarch64-linux-gnu --prefix=/opt/xbmc-deps --host=x86_64-unknown-linux-gnu --with-rendersystem=gles )

	if [ "$CROSS_BUILD" ]; then
	  for i in JsonSchemaBuilder TexturePacker; do
      # CC= LD= CXX= LDFLAGS= CFLAGS= CXXFLAGS= \
      #         make -C tools/depends/native/$i
      (CC= LD= CXX= LDFLAGS= CFLAGS= CXXFLAGS=; cd tools/depends/native/$i/src; ./autogen.sh; ./configure; make )
	  done
	fi
	echo
}

pre_build() {
	# echo "========================"
	# set | grep ^C
	# echo "========================"
	# exit 1
	cd build
	ninja crossguid spdlog libdvdread
}

post_build() {
	# echo "====================================================================================================="
	# echo "CC=\"$CC\" CXX=\"$CXX\" LD=\"$LD\" AR=\"$AR\" RANLIB=\"$RANLIB\" CPP=\"$CPP\" AS=\"$AS\" OBJDUMP=\"$OBJDUMP\" CFLAGS=\"$CFLAGS\" LDFLAGS=\"$LDFLAGS\""
	# echo "====================================================================================================="
	# (
	# 	CC="$CC" CXX="$CXX" LD="$LD" AR="$AR" RANLIB="$RANLIB" \
	# 	CPP="$CPP" AS="$AS" OBJDUMP="$OBJDUMP" \
	# 	CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS";
	# 	cd tools/depends;
	# 	make distclean;
	# 	./configure --with-toolchain=/usr/aarch64-linux-gnu --prefix=${DESTDIR}/usr --host=aarch64-linux-gnu --with-rendersystem=gles
	# )

	# Rebuild for target
	if [ "$CROSS_BUILD" ]; then
		for i in JsonSchemaBuilder TexturePacker; do
			( cd tools/depends/native/$i/src; \
				./configure --prefix=${DESTDIR}/usr --host=aarch64-linux-gnu; \
				make clean; make; make install )
			# #make -C tools/depends/native/$i clean all \
			# 	CC="$CC" CXX="$CXX" LD="$LD" AR="$AR" RANLIB="$RANLIB" \
			# 	CPP="$CPP" AS="$AS" OBJDUMP="$OBJDUMP" \
			# 	CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
		done
	fi
	mkdir -p /usr/x86_64-linux-gnu-native/bin
	ln -sf /usr/bin/cmake /usr/x86_64-linux-gnu-native/bin/cmake
	( CC= LD= CXX= LDFLAGS= CFLAGS= CXXFLAGS=;
		cd tools/depends; \
		make distclean; \
		./configure --with-toolchain=x86_64-linux-gnu --prefix=/usr --host=aarch64-linux-gnu --with-rendersystem=gles;
	)
	make -j8 -C tools/depends/target/binary-addons PREFIX=${DESTDIR}/usr ADDONS=inputstream.adaptive || exit 1
}

post_install() {
	# remove unused stuff
	rm -rf ${DESTDIR}/usr/include
	find ${DESTDIR}/usr/lib -name "*.cmake" -delete
	vsv kodi-standalone
	vinstall ${FILESDIR}/kodi.sudoers 600 etc/sudoers.d kodi
	vinstall ${FILESDIR}/reboot.py 755 usr/share/kodi/system
	mkdir -p ${DESTDIR}/usr/lib/python3.12
	touch ${DESTDIR}/usr/lib/python3.12/.void-python-hack
}

